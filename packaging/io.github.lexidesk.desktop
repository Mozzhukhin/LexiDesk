[Desktop Entry]
Type=Application
Name=LexiDesk
GenericName=Vocabulary Trainer
Comment=Learn vocabulary in your installed languages completely offline
Exec=lexidesk
Icon=io.github.lexidesk
Terminal=false
Categories=Education;Languages;
StartupNotify=false
Keywords=vocabulary;language;offline;translation;flashcards;FSRS;
Actions=Library;Batch;Analytics;

[Desktop Action Library]
Name=Open vocabulary library
Exec=lexidesk --library

[Desktop Action Batch]
Name=Batch add vocabulary
Exec=lexidesk --batch

[Desktop Action Analytics]
Name=Open learning analytics
Exec=lexidesk --analytics
